{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Shift",
  "version": "0.2.2",
  "identifier": "com.gameshift.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:14200",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Game Shift",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "theme": "Dark",
        "backgroundColor": "#0f0d14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https://*.steamgriddb.com; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/assets/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFENTM3NDZDOUU5MzQ0QQpSV1JLTk9uSlJqZlZBZmJPRkQ4c0ZIQXM0WWdZNVVuSUd4RlprYkZKRzR5cUFOK2NyOGFTeUxzaQo=",
      "endpoints": ["https://github.com/mpasdi/game-shift/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
